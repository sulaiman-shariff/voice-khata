GNANI_API_KEY=
ANTHROPIC_API_KEY=
# optional
# SECOND_READING=on        # add the noisy-turn amount cross-check (off: also no language rescue)
# STT_MIN_SILENCE_MS=500   # Prisma realtime VAD silence window (not sent unless set)
# STT_VAD_THRESHOLD=0.7
# LOG_LEVEL=info           # debug | info | warn | error (server logs; debug adds partials, commits, TTS detail)
# LLM for hard turns: Anthropic if ANTHROPIC_API_KEY is set, else Gemini. Several Gemini keys rotate
# on rate limits/errors (GEMINI_API_KEY, GEMINI_API_KEY_2.._9, or GEMINI_API_KEYS=k1,k2).
GEMINI_API_KEY=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_MODEL=gemini-3.5-flash-lite
# LLM_PROVIDER=gemini      # force gemini | anthropic
# WhatsApp reminders through Twilio (see update.md, "Twilio setup"). Without these the app opens
# WhatsApp with the message filled in and the shopkeeper taps send.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # sandbox number (default); your own approved sender later
# TWILIO_CONTENT_SID=                           # optional: approved template, {{1}} name {{2}} amount {{3}} shop
