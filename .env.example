GNANI_API_KEY=
VERTEX_PROJECT=
GOOGLE_VERTEX_KEY=      # base64 service-account JSON (roles/aiplatform.user)
ANTHROPIC_API_KEY=      # Claude Haiku 5.5, raced against Gemini on every text agent turn (unset: Gemini only)
# AGENT_HAIKU=off       # turn the Haiku leg off even with a key (each agent turn's text also goes to Anthropic)
# VERTEX_LOCATION=asia-south1
# GEMINI_MODEL=gemini-3.5-flash-lite
# AGENT_AUDIO_MODEL=gemini-3.5-flash-lite   # model for the audio second call
# LLM_TIMEOUT_MS=3000
# LISTEN_LANGS=en-IN,hi-IN,kn-IN            # heard in every session; off = session language only
# optional
# STT_MIN_SILENCE_MS=500   # Prisma realtime VAD silence window (not sent unless set)
# STT_VAD_THRESHOLD=0.7
# LOG_LEVEL=info           # debug | info | warn | error (server logs; debug adds partials, commits, TTS detail)
# LLM for hard turns: Anthropic if ANTHROPIC_API_KEY is set, else Gemini. Several Gemini keys rotate
# on rate limits/errors (GEMINI_API_KEY, GEMINI_API_KEY_2.._9, or GEMINI_API_KEYS=k1,k2).
GEMINI_API_KEY=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_MODEL=gemini-3.5-flash-lite
# LLM_PROVIDER=gemini      # force gemini | anthropic
# WhatsApp reminders through Twilio (see update.md, "Twilio setup"). Without these the app opens
# WhatsApp with the message filled in and the shopkeeper taps send.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+17372212163   # the trial sender your Twilio console shows (older sandboxes: +14155238886)
# TWILIO_CONTENT_SID=                           # optional: approved template, {{1}} name {{2}} amount {{3}} shop
# Capacitor / APK build only (the UI runs from inside the app, so it must know where the server is):
# VITE_API_BASE=https://voice-khata-delta.vercel.app     # functions + voice socket
# VITE_PUBLIC_URL=https://voice-khata-delta.vercel.app   # links customers open (pay page, confirm); defaults to VITE_API_BASE
# ALLOWED_ORIGINS=https://my-other-site.example          # server: extra origins allowed to call the API
# WhatsApp reminders through Vonage (used instead of Twilio when set). Free sandbox:
# dashboard.nexmo.com → Messaging → Messages Sandbox → WhatsApp; send the passphrase from each phone.
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# VONAGE_WHATSAPP_FROM=14157386102     # the sandbox number, digits only
# VONAGE_SANDBOX=true                  # false for a real approved Vonage WhatsApp number
# VONAGE_WEBHOOK_TOKEN=                # Cloud Run: inbound/status webhook URLs carry ?k=<this> (sandbox does not sign)
# VONAGE_SIGNATURE_SECRET=             # or: verify Vonage signed webhooks (JWT) instead of the token

# Razorpay payment links in reminders; payments book into the khata by themselves (Vercel + Cloud Run)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=             # Cloud Run: the secret set on the Razorpay webhook
# CRON_SECRET=                         # Cloud Scheduler -> /internal/reminders-tick (x-cron-secret), Vercel cron
# VITE_DEMO_UPI=khatabhai.demo@example   # demo only: pay line in reminders until the shop enters its own UPI ID
